import kotlin.Boolean;

CREATE TABLE ActivitySubcategory (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    category_id INTEGER NOT NULL,
    default_label_id INTEGER,
    is_visible INTEGER AS Boolean NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 0,

    FOREIGN KEY(category_id) REFERENCES ActivityCategory(id) ON DELETE CASCADE,
    FOREIGN KEY(default_label_id) REFERENCES ActivityLabel(id) ON DELETE SET NULL
);

CREATE UNIQUE INDEX idx_activity_subcategory_unique
ON ActivitySubcategory(category_id, name);

CREATE INDEX idx_activity_subcategory_category_id
ON ActivitySubcategory(category_id);