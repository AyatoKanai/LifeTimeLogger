import kotlin.Boolean;

CREATE TABLE ActivityCategory (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT NOT NULL,
    default_label_id INTEGER,
    is_visible INTEGER AS Boolean NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 0,

    FOREIGN KEY(default_label_id) REFERENCES ActivityLabel(id) ON DELETE SET NULL
);

CREATE UNIQUE INDEX idx_activity_category_name
ON ActivityCategory(name);
